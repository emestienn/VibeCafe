# Postgres connection string.
# Local dev default (Homebrew postgresql@16, no password, trust auth).
# Replace "tanzilanosirova" with your local OS/Postgres username (`whoami`).
DATABASE_URL="postgresql://tanzilanosirova@127.0.0.1:5432/vibecafe?schema=public"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Leave blank to disable "Continue with Google" and use email/password only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
